      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p1_di" bpmnElement="p1">
        <di:waypoint x="146" y="240.0" />
        <di:waypoint x="640" y="239.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p2_di" bpmnElement="p2">
