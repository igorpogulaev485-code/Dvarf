        <dc:Bounds x="2620" y="1202.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_npc_di" bpmnElement="n_npc">
        <dc:Bounds x="2084" y="68" width="360" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p1_di" bpmnElement="p1">
        <di:waypoint x="136" y="200.0" />
        <di:waypoint x="348" y="199.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p2_di" bpmnElement="p2">
        <di:waypoint x="548" y="199.0" />
        <di:waypoint x="844" y="199.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p3_di" bpmnElement="p3">
        <di:waypoint x="1044" y="199.0" />
        <di:waypoint x="1340" y="199.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p4_di" bpmnElement="p4">
        <di:waypoint x="1540" y="199.0" />
        <di:waypoint x="1836" y="202.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p5_di" bpmnElement="p5">
        <di:waypoint x="2066" y="202.0" />
        <di:waypoint x="2084" y="199.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p6_di" bpmnElement="p6">
        <di:waypoint x="548" y="199.0" />
        <di:waypoint x="696.0" y="199.0" />
        <di:waypoint x="696.0" y="337.0" />
        <di:waypoint x="844" y="337.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p7_di" bpmnElement="p7">
        <di:waypoint x="1074" y="337.0" />
        <di:waypoint x="1340" y="337.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p8_di" bpmnElement="p8">
        <di:waypoint x="1570" y="337.0" />
        <di:waypoint x="1836" y="337.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p9_di" bpmnElement="p9">
        <di:waypoint x="2284" y="199.0" />
        <di:waypoint x="2432.0" y="199.0" />
        <di:waypoint x="2432.0" y="260.0" />
        <di:waypoint x="2580" y="260.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p10_di" bpmnElement="p10">
        <di:waypoint x="2066" y="337.0" />
        <di:waypoint x="2323.0" y="337.0" />
        <di:waypoint x="2323.0" y="260.0" />
