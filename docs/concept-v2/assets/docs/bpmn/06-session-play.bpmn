        <dc:Bounds x="1340" y="157.0" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_reac_di" bpmnElement="p_reac">
        <dc:Bounds x="1836" y="157.0" width="230" height="90" />
      </bpmndi:BPMNShape>
