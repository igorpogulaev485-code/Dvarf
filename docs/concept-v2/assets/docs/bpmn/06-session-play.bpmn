        <dc:Bounds x="2084" y="157.0" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_hp_di" bpmnElement="p_hp">
        <dc:Bounds x="844" y="292.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_death_di" bpmnElement="p_death">
        <dc:Bounds x="1340" y="292.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_rest_di" bpmnElement="p_rest">
        <dc:Bounds x="1836" y="292.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_end_di" bpmnElement="p_end">
        <dc:Bounds x="2580" y="242.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_start_di" bpmnElement="m_start">
        <dc:Bounds x="100" y="672.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_att_di" bpmnElement="m_att">
        <dc:Bounds x="348" y="647.0" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_comb_di" bpmnElement="m_comb">
        <dc:Bounds x="844" y="647.0" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_init_di" bpmnElement="m_init">
        <dc:Bounds x="1340" y="647.0" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_atk_di" bpmnElement="m_atk">
        <dc:Bounds x="1836" y="647.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_awd_di" bpmnElement="m_awd">
        <dc:Bounds x="1340" y="782.0" width="230" height="90" />
      </bpmndi:BPMNShape>
