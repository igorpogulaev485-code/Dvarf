<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_session" name="6. Игровая сессия в лобби" targetNamespace="https://creed20.tech/bpmn" exporter="КриD20 BPMN maps" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_session">
    <bpmn:participant id="Pool_Player" name="Игрок" processRef="Proc_Player" />
    <bpmn:participant id="Pool_Master" name="Мастер" processRef="Proc_Master" />
    <bpmn:participant id="Pool_System" name="Система / бэкенд" processRef="Proc_System" />
    <bpmn:messageFlow id="msg_seat" name="сесть" sourceRef="p_seat" targetRef="s_seat" />
    <bpmn:messageFlow id="msg_atk" name="sheet-attack" sourceRef="p_turn" targetRef="s_cb" />
    <bpmn:messageFlow id="msg_re" name="declare / skip" sourceRef="p_reac" targetRef="s_cb" />
    <bpmn:messageFlow id="msg_matk" name="combat/attack" sourceRef="m_atk" targetRef="s_cb" />
    <bpmn:messageFlow id="msg_aw" name="награды" sourceRef="m_awd" targetRef="s_aw" />
    <bpmn:messageFlow id="msg_pr" name="party-rest" sourceRef="m_rest" targetRef="s_aw" />
    <bpmn:messageFlow id="msg_pr2" name="party_rest" sourceRef="s_ws" targetRef="p_rest" />
    <bpmn:messageFlow id="msg_hp" name="session_changed" sourceRef="s_ws" targetRef="p_hp" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Player" name="Игрок" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_Player">
      <bpmn:lane id="Lane_Player" name="Игрок">
        <bpmn:flowNodeRef>p_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_seat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_turn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_reac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_dice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_hp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_death</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p_start" name="Открыть /sessions/:id">
      <bpmn:outgoing>p1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="p_seat" name="Если не за столом — «Сесть за стол»
(свой герой из состава)">
      <bpmn:incoming>p1</bpmn:incoming>
      <bpmn:outgoing>p2</bpmn:outgoing>
      <bpmn:outgoing>p6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_init" name="Бросок инициативы, если слот «ждём бросок»">
      <bpmn:incoming>p2</bpmn:incoming>
      <bpmn:outgoing>p3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_turn" name="Свой ход: экономика хода,
атака с листа (sheet-attack)">
      <bpmn:incoming>p3</bpmn:incoming>
      <bpmn:outgoing>p4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_reac" name="Окно «Есть ли реакция?»: объявить /
«Нет реакции» / автопропуск 10 с">
      <bpmn:incoming>p4</bpmn:incoming>
      <bpmn:outgoing>p5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_dice" name="Кубики и журнал сессии
(ручной / цифровой бросок)">
      <bpmn:incoming>p5</bpmn:incoming>
      <bpmn:outgoing>p9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_hp" name="Хиты: свои точно; чужие — по профилю
видимости (числа / полоса / скрыто)">
      <bpmn:incoming>p6</bpmn:incoming>
      <bpmn:outgoing>p7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_death" name="Свои спасброски смерти видны себе
(и мастеру, если hidden_death_saves)">
      <bpmn:incoming>p7</bpmn:incoming>
      <bpmn:outgoing>p8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="p_rest" name="WS party_rest открывает RestDialog
на листе — игрок сам завершает отдых">
      <bpmn:incoming>p8</bpmn:incoming>
      <bpmn:outgoing>p10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p_end" name="Сессия закрыта">
      <bpmn:incoming>p9</bpmn:incoming>
      <bpmn:incoming>p10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="n_npc"><bpmn:text>Спасброски напарников: story и живой купленный скакун — да; зверь следопыта / primal / drake / призванные / облик — нет. У карточки врага (EnemyCard) UI спасбросков нет.</bpmn:text></bpmn:textAnnotation>
    <bpmn:sequenceFlow id="p1" name="" sourceRef="p_start" targetRef="p_seat" />
    <bpmn:sequenceFlow id="p2" name="" sourceRef="p_seat" targetRef="p_init" />
    <bpmn:sequenceFlow id="p3" name="" sourceRef="p_init" targetRef="p_turn" />
    <bpmn:sequenceFlow id="p4" name="" sourceRef="p_turn" targetRef="p_reac" />
    <bpmn:sequenceFlow id="p5" name="" sourceRef="p_reac" targetRef="p_dice" />
    <bpmn:sequenceFlow id="p6" name="" sourceRef="p_seat" targetRef="p_hp" />
    <bpmn:sequenceFlow id="p7" name="" sourceRef="p_hp" targetRef="p_death" />
    <bpmn:sequenceFlow id="p8" name="" sourceRef="p_death" targetRef="p_rest" />
    <bpmn:sequenceFlow id="p9" name="" sourceRef="p_dice" targetRef="p_end" />
    <bpmn:sequenceFlow id="p10" name="" sourceRef="p_rest" targetRef="p_end" />
  </bpmn:process>
  <bpmn:process id="Proc_Master" name="Мастер" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_Master">
      <bpmn:lane id="Lane_Master" name="Мастер">
        <bpmn:flowNodeRef>m_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_att</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_comb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_init</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_atk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_awd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="m_start" name="Вести стол">
      <bpmn:outgoing>m1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="m_att" name="Посещаемость: посадить / убрать
с места">
      <bpmn:incoming>m1</bpmn:incoming>
      <bpmn:outgoing>m2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_comb" name="Старт боя, противники, волны,
бой из вики / генератор встреч">
      <bpmn:incoming>m2</bpmn:incoming>
      <bpmn:outgoing>m3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_init" name="Инициатива партии (серверный бросок
или ожидание игроков)">
      <bpmn:incoming>m3</bpmn:incoming>
      <bpmn:outgoing>m4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_atk" name="Атака стола POST …/combat/attack;
ход next/prev, пропуск реакции">
      <bpmn:incoming>m4</bpmn:incoming>
      <bpmn:outgoing>m5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_awd" name="XP, добыча, сундук, выдача в инвентарь,
состояния, эффекты, благочестие">
      <bpmn:incoming>m5</bpmn:incoming>
      <bpmn:outgoing>m6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_rest" name="Партийный отдых (не в бою,
нужны места за столом)">
      <bpmn:incoming>m6</bpmn:incoming>
      <bpmn:outgoing>m7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="m_close" name="Закрыть сессию, опционально запись
в журнал; снять retained seats">
      <bpmn:incoming>m7</bpmn:incoming>
      <bpmn:outgoing>m8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="m_end" name="Итог записан">
      <bpmn:incoming>m8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="m1" name="" sourceRef="m_start" targetRef="m_att" />
    <bpmn:sequenceFlow id="m2" name="" sourceRef="m_att" targetRef="m_comb" />
    <bpmn:sequenceFlow id="m3" name="" sourceRef="m_comb" targetRef="m_init" />
    <bpmn:sequenceFlow id="m4" name="" sourceRef="m_init" targetRef="m_atk" />
    <bpmn:sequenceFlow id="m5" name="" sourceRef="m_atk" targetRef="m_awd" />
    <bpmn:sequenceFlow id="m6" name="" sourceRef="m_awd" targetRef="m_rest" />
    <bpmn:sequenceFlow id="m7" name="" sourceRef="m_rest" targetRef="m_close" />
    <bpmn:sequenceFlow id="m8" name="" sourceRef="m_close" targetRef="m_end" />
  </bpmn:process>
  <bpmn:process id="Proc_System" name="Система / бэкенд" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proc_System">
      <bpmn:lane id="Lane_System" name="Система / бэкенд">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_seat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_cb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_mut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_aw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_ws</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Сессия открыта">
      <bpmn:outgoing>s1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="s_seat" name="POST/DELETE …/seats
(+ слот «ждём бросок», если бой идёт)">
      <bpmn:incoming>s1</bpmn:incoming>
      <bpmn:outgoing>s2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_cb" name="combat/start, initiative, attack,
sheet-attack, reaction, patch">
      <bpmn:incoming>s2</bpmn:incoming>
      <bpmn:outgoing>s3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_mut" name="patch_seat_combat, companions,
условия, хиты, смерть — пишут sheet">
      <bpmn:incoming>s3</bpmn:incoming>
      <bpmn:outgoing>s4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_aw" name="award xp/loot, grants, transfer,
party-rest (событие, не применение)">
      <bpmn:incoming>s4</bpmn:incoming>
      <bpmn:outgoing>s5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="s_ws" name="WS: session_changed, session_event,
party_rest, turn_started, turn_economy_reset">
      <bpmn:incoming>s5</bpmn:incoming>
      <bpmn:outgoing>s6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="s_end" name="События в ленте">
      <bpmn:incoming>s6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="s1" name="" sourceRef="s_start" targetRef="s_seat" />
    <bpmn:sequenceFlow id="s2" name="" sourceRef="s_seat" targetRef="s_cb" />
    <bpmn:sequenceFlow id="s3" name="" sourceRef="s_cb" targetRef="s_mut" />
    <bpmn:sequenceFlow id="s4" name="" sourceRef="s_mut" targetRef="s_aw" />
    <bpmn:sequenceFlow id="s5" name="" sourceRef="s_aw" targetRef="s_ws" />
    <bpmn:sequenceFlow id="s6" name="" sourceRef="s_ws" targetRef="s_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_session">
    <bpmndi:BPMNPlane id="Plane_session" bpmnElement="Collab_session">
      <bpmndi:BPMNShape id="Pool_Player_di" bpmnElement="Pool_Player" isHorizontal="true">
        <dc:Bounds x="40" y="60" width="3500" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Player_di" bpmnElement="Lane_Player" isHorizontal="true">
        <dc:Bounds x="70" y="60" width="3470" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Master_di" bpmnElement="Pool_Master" isHorizontal="true">
        <dc:Bounds x="40" y="550" width="3500" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Master_di" bpmnElement="Lane_Master" isHorizontal="true">
        <dc:Bounds x="70" y="550" width="3470" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_System_di" bpmnElement="Pool_System" isHorizontal="true">
        <dc:Bounds x="40" y="1040" width="3500" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="70" y="1040" width="3470" height="360" />
      </bpmndi:BPMNShape>
