        <dc:Bounds x="2332" y="782.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="m_end_di" bpmnElement="m_end">
        <dc:Bounds x="2600" y="802.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_start_di" bpmnElement="s_start">
        <dc:Bounds x="100" y="1202.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_seat_di" bpmnElement="s_seat">
        <dc:Bounds x="348" y="1177.0" width="200" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_cb_di" bpmnElement="s_cb">
        <dc:Bounds x="844" y="1177.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_mut_di" bpmnElement="s_mut">
        <dc:Bounds x="1340" y="1177.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_aw_di" bpmnElement="s_aw">
        <dc:Bounds x="1836" y="1177.0" width="230" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_ws_di" bpmnElement="s_ws">
        <dc:Bounds x="2332" y="1177.0" width="250" height="90" />
