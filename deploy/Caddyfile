# TLS edge in front of dvarf-web (docker service name `web`).
# Caddy obtains/renews Let’s Encrypt automatically.

{
	email info@creed20.tech
	# HTTP/3 (QUIC, UDP 443) выключен: через VPN он часто не доходит, и браузер
	# ждёт до таймаута, хотя TCP живой. Caddy сам проксирует WebSocket (Upgrade).
	# Вернуть h3: заменить protocols на `h1 h2 h3` и в docker-compose.prod.yml
	# у сервиса edge снова опубликовать "443:443/udp".
	servers {
		protocols h1 h2
	}
}

creed20.tech {
	encode gzip
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}

www.creed20.tech {
	redir https://creed20.tech{uri} permanent
}

# Old bookmarks used bare IP over HTTP — that path breaks under many mobile VPNs
# (MTU blackhole / no TLS). Canon is HTTPS on the real domain.
http://201.34.132.252 {
	redir https://creed20.tech{uri} permanent
}
