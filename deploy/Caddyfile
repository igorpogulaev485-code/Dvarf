# TLS edge in front of dvarf-web (docker service name `web`).
# Caddy obtains/renews Let’s Encrypt automatically.

{
	email info@creed20.tech
}

creed20.tech {
	encode gzip
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}

www.creed20.tech {
	redir https://creed20.tech{uri} permanent
}

# Keep IP bookmarks working over HTTP (no cert for bare IP).
http://201.34.132.252 {
	encode gzip
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}
}
