        "traits": [
          {
            "name_ru": "Эфемерное движение",
            "text_ru": "Воплощение может перемещаться через других существ и объекты, как если бы они были Труднопроходимой местностью; его движение не Провоцирует атак. Оно получает 5 (1к10) Силового урона, если завершает свой ход внутри объекта.",
            "name_ru_pending": false
          },
          {
            "name_ru": "Сопротивлении магии",
            "text_ru": "Воплощение совершает с Преимуществом спасброски от заклинаний и прочих магических эффектов.",
            "name_ru_pending": false
          }
        ],
        "actions": [
          {
            "name_ru": "Мультиатака",
            "text_ru": "Воплощение совершает три атаки Укусом или Миазматическим сгустком в любой комбинации.",
            "name_ru_pending": false
          },
          {
            "name_ru": "Укус",
            "text_ru": "Бросок рукопашной атаки: +8, досягаемость 5 фт. Попадание: 14 (2к8 + 5) Колющего урона.",
            "name_ru_pending": false
          },
          {
            "name_ru": "Миазматический сгусток",
            "text_ru": "Бросок дальнобойной атаки: +8, дистанция 60/120 фт. Попадание: 15 (6к4) Кислотного урона, и Скорость цели снижается на 10 футов до конца следующего хода воплощения.",
            "name_ru_pending": false
          },
          {
            "name_ru": "Призрачная давка",
            "text_ru": "Воплощение перемещается на расстояние вплоть до 80 футов по прямой. Каждое существо, в чьё пространство входит воплощение, единожды подвергается следующему эффекту. Спасбросок Ловкости: Сл 16. Провал: 18 (4к8) Силового урона. Если цель — существо Большого размера или меньше, она Опрокидывается. Успех: Только половина урона.",
            "name_ru_pending": false
          }
        ],
        "bonus_actions": [
          {
            "name_ru": "Перевоплощение",
            "text_ru": "Воплощение меняет свой размер на Средний, Большой или Огромный.",
            "name_ru_pending": false
          }
        ]
      }
