POSTGRES_DB=dvarf
POSTGRES_USER=dvarf
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-long-random
# Access covers long table sessions; refresh slides while the app is open.
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=90
CORS_ORIGINS=https://creed20.tech,http://creed20.tech,http://201.34.132.252
APP_PUBLIC_URL=https://creed20.tech
AUTH_EMAIL_STUB=false
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_CHANGE_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=60

# Mail.ru SMTP — пароль только в /opt/dvarf/.env на сервере, не в git
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Empty → derived from APP_PUBLIC_URL (/auth/oauth/yandex/callback)
YANDEX_REDIRECT_URI=https://creed20.tech/auth/oauth/yandex/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Empty → derived from APP_PUBLIC_URL (/auth/oauth/vk/callback)
VK_REDIRECT_URI=https://creed20.tech/auth/oauth/vk/callback
VK_SERVICE_TOKEN=
