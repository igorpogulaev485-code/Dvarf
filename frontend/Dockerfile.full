# Fallback: full in-container frontend build (node + npm ci + vite).
# Emergency only: DVARF_FRONTEND_DOCKERFILE=Dockerfile.full ./deploy/sync-and-up.sh
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
