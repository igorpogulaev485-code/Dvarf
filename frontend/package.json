{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "selfcheck:pending-choices": "tsx src/shared/dnd/pendingFeatureChoices.selfcheck.ts",
    "selfcheck:spell-catalog": "tsx src/shared/dnd/spellCatalog.selfcheck.ts",
    "selfcheck:conditions": "tsx src/shared/dnd/conditions.selfcheck.ts",
    "selfcheck:race-natural-weapons": "tsx src/shared/dnd/raceNaturalWeapons.selfcheck.ts && node --input-type=module -e \"import {readFileSync} from 'node:fs'; const j=JSON.parse(readFileSync('../backend/data/races/mpmm_race_catalog_spec.json','utf8')); const a=j.races.find(r=>r.slug==='aarakocra'); if(a?.natural_weapons?.[0]?.damage!=='1к4') { console.error('spec aarakocra talons must be 1к4'); process.exit(1);} console.log('spec aarakocra talons=1к4 ok');\"",
    "selfcheck:inventory-packs": "tsx src/features/characters/inventoryPacks.selfcheck.ts",
    "selfcheck:feature-summon": "tsx src/features/characters/featureSummon.selfcheck.ts",
    "selfcheck:subclass-grants": "tsx src/shared/dnd/subclassGrants.selfcheck.ts",
    "selfcheck:attunement": "tsx src/features/characters/attunement.selfcheck.ts",
    "selfcheck:starting-gear-attacks": "tsx src/features/characters/startingGearAttacks.selfcheck.ts",
    "selfcheck:class-equipment-lines": "tsx src/shared/dnd/classEquipmentLines.selfcheck.ts",
    "selfcheck:desk-rolls": "tsx --tsconfig tsconfig.app.json src/features/characters/deskRolls.selfcheck.ts",
    "selfcheck:divine-smite": "tsx --tsconfig tsconfig.app.json src/features/characters/divineSmite.selfcheck.ts",
    "selfcheck:race-naming": "tsx src/shared/dnd/raceNaming.selfcheck.ts",
    "selfcheck:feat-stealthy": "tsx src/shared/dnd/featGrants.stealthy.selfcheck.ts",
    "selfcheck:background-setup": "tsx src/shared/dnd/backgroundSetupValidation.selfcheck.ts",
    "selfcheck:race-effects-contract": "tsx src/shared/dnd/raceEffectsContract.selfcheck.ts",
    "selfcheck:create-pipeline-gear": "tsx src/features/createPipeline/createPipelineGear.selfcheck.ts",
    "selfcheck:optional-class-features": "tsx src/shared/dnd/optionalClassFeatures.selfcheck.ts",
    "selfcheck:o02-tasha-features": "tsx src/shared/dnd/o02TashaFeatures.selfcheck.ts",
    "selfcheck:o06-styles-breath": "tsx src/shared/dnd/o06StylesBreathInvocations.selfcheck.ts",
    "selfcheck:o07-reactions": "tsx src/shared/dnd/o07Reactions.selfcheck.ts",
    "selfcheck:o08-actions-cover": "tsx src/shared/dnd/o08ActionsCoverConditions.selfcheck.ts",
    "selfcheck:o09-death-inspiration-ammo": "tsx src/shared/dnd/o09DeathInspirationAmmo.selfcheck.ts",
    "selfcheck:o10-mounted-underwater": "tsx src/shared/dnd/o10MountedUnderwater.selfcheck.ts",
    "selfcheck:feature-replacement": "tsx src/shared/dnd/featureReplacement.selfcheck.ts",
    "selfcheck:background-feature": "tsx src/shared/dnd/backgroundFeature.selfcheck.ts",
    "selfcheck:consumable-spend": "tsx src/features/characters/consumableSpend.selfcheck.ts",
    "selfcheck:magic-sources": "tsx src/features/characters/magicSources.selfcheck.ts",
    "selfcheck:resource-disambiguate": "tsx src/shared/dnd/featureResources.disambiguate.selfcheck.ts",
    "selfcheck:cast-effect": "tsx src/shared/dnd/spellCatalog.castEffect.selfcheck.ts",
    "selfcheck:desk-split": "tsx src/features/characters/playDeskUi.deskSplit.selfcheck.ts",
    "selfcheck:jump-distance": "tsx src/shared/dnd/jumpDistance.selfcheck.ts",
    "selfcheck:spells-settings-slots": "tsx src/features/characters/spellsSettings.visibleSlots.selfcheck.ts",
    "selfcheck:enemy-pack-roster": "tsx --tsconfig tsconfig.app.json src/features/lobby/enemyPackRoster.selfcheck.ts",
    "selfcheck:artifact-gear": "tsx --tsconfig tsconfig.app.json src/features/characters/artifactGear.selfcheck.ts",
    "selfcheck:hot-bar-scroll": "tsx --tsconfig tsconfig.app.json src/features/characters/PlayDeskHotBar.selfcheck.ts",
    "selfcheck:needs-setup": "tsx --tsconfig tsconfig.app.json src/features/characters/needsSetup.selfcheck.ts",
    "selfcheck:m01-mobile-header": "tsx --tsconfig tsconfig.app.json src/features/characters/m01MobileHeader.selfcheck.ts",
    "selfcheck:m02-combat-first-screen": "tsx --tsconfig tsconfig.app.json src/features/characters/m02CombatFirstScreen.selfcheck.ts",
    "selfcheck:m04-create-mobile": "tsx --tsconfig tsconfig.app.json src/features/createPipeline/m04CreateMobile.selfcheck.ts",
    "selfcheck:onboarding-display": "tsx --tsconfig tsconfig.app.json src/features/onboarding/onboardingDisplay.selfcheck.ts",
    "test:e2e:onboarding": "playwright test --config=playwright.onboarding.config.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
